// Merge into android/app/build.gradle.kts (Flutter 3.38 template).

android {
    namespace = "org.survivalnode.mobile"
    compileSdk = 36
    ndkVersion = "28.2.13676358" // NDK r28+: 16 KB page-size aligned by default

    defaultConfig {
        applicationId = "org.survivalnode.mobile"
        minSdk = 26
        targetSdk = 36
        ndk { abiFilters += listOf("arm64-v8a") } // llama.cpp Q4 kernels: arm64 only
        externalNativeBuild {
            cmake {
                arguments += listOf("-DANDROID_STL=c++_shared", "-DCMAKE_BUILD_TYPE=Release")
                cppFlags += listOf("-std=c++17")
            }
        }
    }

    externalNativeBuild {
        cmake {
            path = file("../../native/CMakeLists.txt")
            version = "3.22.1"
        }
    }

    packaging {
        jniLibs.useLegacyPackaging = false // keep .so uncompressed + page-aligned in the APK
    }
}
